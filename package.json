{
  "name": "all-in-one-downloader",
  "productName": "All in One Downloader",
  "version": "0.17.0",
  "description": "Bir bağlantı yapıştır, sayfadaki videoları çıkar ve indir.",
  "private": true,
  "main": "electron/main.js",
  "author": "erne",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,yellow \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "predev": "node build/biometric-helper.js",
    "prestart": "node build/biometric-helper.js"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "wait-on": "^8.0.2"
  }
}
